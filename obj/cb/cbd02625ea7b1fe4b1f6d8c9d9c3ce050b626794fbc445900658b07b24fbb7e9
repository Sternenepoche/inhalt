      if (gezogen) { gezogen.fest = false; if (kurz) { const k = gezogen; if (k.art === 'tag') { notizSuche = k.name; reiter = 'notizen'; zeichnen(); } else if (k.art === 'fehlt') neueNotiz(k.name); else { offeneNotiz = alle.find(n => n.pfad.toLowerCase() === k.id).pfad; vorschau = true; reiter = 'notizen'; zeichnen(); } } }
      start = null; gezogen = null;
    }
  };
  cv.onwheel = e => { e.preventDefault(); einpassen = false; cam.z = Math.max(.25, Math.min(3, cam.z * (e.deltaY < 0 ? 1.1 : .9))); };
}

