'use strict';
// Handy-Cockpit von Sternenepoche: liegt als eigene Ebene (Shadow DOM) über dem Spiel und
// verändert dessen Abläufe nicht. Es liest nur, was das Spiel ohnehin sichtbar anzeigt
// (`view`, `world`), nie versteckte Inhalte, und sendet selbst nichts an den Spielserver.
// Flottenbefehle bleiben Befehle des Spielers: „Flotte hierhin“ füllt nur das Formular aus.
(() => {
if (window.SternMobil) return;
const app = window.SternApp;
if (!app) return;
const START = location.protocol === 'file:';
const BASIS = START ? '../mobil/' : '/__mobil/';

// ------------------------------------------------------------------ Brücke (geteilt mit start.js)
if (!window.SternBus) {
  const hoerer = {}, warte = {}; let nr = 0;
  window.SternBus = {
    an(art, f) { (hoerer[art] ||= []).push(f); },
    rufe(methode, ...args) { return new Promise((ok, nein) => { const id = 'm' + (++nr); warte[id] = {ok, nein}; app[methode](id, ...args); }); },
    sync(methode, ...args) { const roh = app[methode](...args); const r = roh ? JSON.parse(roh) : {}; if (r && !Array.isArray(r) && r.fehler) throw new Error(r.fehler); return r; },
  };
  window.SternEreignis = (art, d) => (hoerer[art] || []).forEach(f => { try { f(d); } catch (e) { console.error(e); } });
  window.SternAntwort = (id, f, w) => { const x = warte[id]; delete warte[id]; if (x) f ? x.nein(new Error(f)) : x.ok(w); };
}
const {sync} = window.SternBus;
// The local server keeps its origin on recovery. Refresh the existing page and its
// durable session as soon as the service becomes healthy; retain forms and selection.
window.SternBus.an('welt', w => {
  if (START || !['127.0.0.1','localhost'].includes(location.hostname)) return;
  if (w.status === 'laeuft' && w.url === location.origin && typeof window.refresh === 'function') window.refresh();
});

const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]));
const zahl = n => Number(n || 0).toLocaleString('de-DE', {maximumFractionDigits: 0});
const jetzt = () => Date.now();
const uid = () => jetzt().toString(36) + Math.random().toString(36).slice(2, 7);
// Koordinate Sektor:System:Planet (z. B. 1:27:6). Uhrzeiten (12:30:05) sind keine Koordinaten.
const KOORD = /(?<![\d:.])(\d{1,2}):(\d{1,3}):(\d{1,2})(?![\d:])/g;
const istZeit = k => /^\d{2}:\d{2}:\d{2}$/.test(k);
const koordinaten = t => [...String(t || '').matchAll(KOORD)].map(m => m[0]).filter(k => !istZeit(k));
const MISSIONEN = [['angriff', 'Angriff'], ['spionage', 'Ausspähen'], ['transport', 'Transport'], ['stationieren', 'Stationieren'], ['uebergeben', 'Übergeben'],
  ['kolonisieren', 'Kolonisieren'], ['saven', 'Saven'], ['recyceln', 'Recyceln'], ['abbau', 'Abbau'], ['halten', 'Halten'], ['verstaerken', 'Bodenhilfe'],
  ['blockade', 'Blockade'], ['bombardieren', 'Bombardieren'], ['kampfkolonisieren', 'Kampfkolonisieren'], ['system_erkunden', 'System erkunden']];

// ------------------------------------------------------------------ Spielzustand (nur lesen)
const spielView = () => { try { return typeof view !== 'undefined' && view && typeof view === 'object' && !(view instanceof Element) ? view : null; } catch { return null; } };
const spielWelt = () => { try { return typeof world !== 'undefined' && world && typeof world === 'object' && !(world instanceof Element) ? world : null; } catch { return null; } };
const imSpiel = () => !START && typeof window.pickFleet === 'function';
let infoCache = null;
function appInfo() { if (!infoCache) try { infoCache = sync('info'); } catch { infoCache = {}; } return infoCache; }
function weltSchluessel() {
  const w = spielWelt();
  if (w?.world_id) return String(w.world_id);
  if (START) return appInfo().welt?.world_id || 'allgemein';
  return location.host;
}
const spielTag = () => { const w = spielWelt(); return w ? Math.floor((w.sekunden || 0) / 86400) + 1 : null; };

// ------------------------------------------------------------------ Ablage je Welt (echte Dateien in der App)
const ablage = {}; let ablageWelt = ''; const speicherTimer = {};
function laden(name) {
  const w = weltSchluessel();
  if (w !== ablageWelt) { ablageWelt = w; for (const k of Object.keys(ablage)) delete ablage[k]; }
  if (!ablage[name]) {
    let v = {};
    try { const s = app.ablageLesen(w, name); v = s ? JSON.parse(s) : {}; if (v.fehler) v = {}; } catch { v = {}; }
    ablage[name] = v;
  }
  return ablage[name];
}
function speichern(name, sofort = false) {
  clearTimeout(speicherTimer[name]);
  const tun = () => { try { const r = JSON.parse(app.ablageSchreiben(ablageWelt, name, JSON.stringify(ablage[name])) || '{}'); if (r.fehler) toast(r.fehler, true); } catch (e) { toast(e.message, true); } };
  if (sofort) tun(); else speicherTimer[name] = setTimeout(tun, 400);
}
const ziele = () => { const k = laden('koordinaten'); k.liste ||= []; return k; };
const plan = () => { const p = laden('plan'); p.aufgaben ||= []; return p; };
const spionage = () => { const s = laden('spionage'); s.berichte ||= {}; s.ordner ||= ['Farmen', 'Gefährlich', 'Allianz', 'Beobachten']; return s; };

// ------------------------------------------------------------------ Oberfläche im Shadow DOM
const wirt = document.createElement('div');
wirt.id = 'stern-mobil-wirt';
const schatten = wirt.attachShadow({mode: 'open'});
schatten.innerHTML = `<link rel="stylesheet" href="${BASIS}mobil.css">
<button class="fab" id="fab" aria-label="Handy-Cockpit öffnen" ${START ? 'hidden' : ''}>◆</button>
<div class="zielleiste" id="zielleiste" hidden></div>
<div class="menue" id="menue" hidden></div>
<div class="toast" id="toast" hidden></div>
<section class="blatt" id="blatt" hidden>
  <header><b>Handy-Cockpit</b><span id="blatt-welt" class="matt"></span><button class="zu" id="zu" aria-label="Schließen">✕</button></header>
  <nav class="reiter" id="reiter">
    <button data-r="notizen">Notizen</button><button data-r="graph">Graph</button><button data-r="plan">Plan</button>
    <button data-r="spionage">Spionage</button><button data-r="ziele">Ziele</button>
  </nav>
  <div class="inhalt" id="inhalt"></div>
</section>`;
const $ = id => schatten.getElementById(id);
(document.body ? Promise.resolve() : new Promise(r => addEventListener('DOMContentLoaded', r))).then(() => document.body.append(wirt));

let toastTimer;
function toast(text, fehler = false) {
  const t = $('toast'); t.textContent = text; t.hidden = false; t.classList.toggle('fehler', fehler);
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.hidden = true, fehler ? 6000 : 2600);
}
const brumm = () => { try { app.vibrieren(18); } catch {} };

let reiter = 'notizen';
function oeffnen(r) {
  if (r) reiter = r;
  $('blatt').hidden = false; $('fab').hidden = true;
  document.documentElement.style.overflow = 'hidden';
  zeichnen();
}
function schliessen() {
  $('blatt').hidden = true; $('fab').hidden = START || imMenue;
  document.documentElement.style.overflow = '';
  graphStopp();
}
$('fab').onclick = () => { brumm(); oeffnen(); };
// Im Spiel öffnet „Mehr → Cockpit“ das Handy-Cockpit. Kein schwebender Knopf mehr über Inhalt und unterer Menüleiste
// (APK 0.4.0: der ◆-Knopf lag auf „Mehr“). Ohne Spielmenü (Startseite, alte Seiten) bleibt der Knopf.
let imMenue = false;
function cockpitImMenue() {
  const nav = document.getElementById('tabs');
  if (START || !nav || !nav.querySelector('[data-menue-mehr]')) return false;
  if (!nav.querySelector('[data-menue="cockpit"]')) {
    nav.insertAdjacentHTML('beforeend', '<button type="button" data-menue="cockpit" class="menue-gold" title="Handy-Cockpit: Notizen, Graph, Plan, Spionage, Ziele"><span class="menue-name">Cockpit</span><svg class="menue-symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l9 9-9 9-9-9z"/></svg></button>');
    nav.querySelector('[data-menue="cockpit"]').onclick = e => {
      e.stopPropagation(); nav.classList.remove('mehr-offen'); nav.querySelector('[data-menue-mehr]')?.setAttribute('aria-expanded', 'false');
      brumm(); oeffnen();
    };
  }
  // Der Stern oben links öffnet das Cockpit ebenfalls – immer sichtbar, ein Tipp (19.10.2026, Karl: „wo ist die Tiefe hin?“).
  const stern = document.querySelector('header .brand');
  if (stern && !stern.dataset.cockpit) {
    stern.dataset.cockpit = '1'; stern.setAttribute('role', 'button'); stern.setAttribute('tabindex', '0');
    stern.setAttribute('aria-label', 'Handy-Cockpit öffnen: Notizen, Graph, Plan, Spionage, Ziele');
    const auf = e => { if (!document.body.dataset.playing) return; e.preventDefault(); e.stopPropagation(); brumm(); oeffnen(); };
    stern.addEventListener('click', auf, true);
    stern.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') auf(e); });
  }
  imMenue = true; $('fab').hidden = true; return true;
}
if (!cockpitImMenue()) { let n = 0; const t = setInterval(() => { if (cockpitImMenue() || ++n > 40) clearInterval(t); }, 250); }
document.addEventListener('game-navigation', () => { if (!imMenue) cockpitImMenue(); });
$('zu').onclick = schliessen;
$('reiter').querySelectorAll('button').forEach(b => b.onclick = () => { reiter = b.dataset.r; offeneNotiz = null; zeichnen(); });

function zeichnen() {
  $('reiter').querySelectorAll('button').forEach(b => b.classList.toggle('an', b.dataset.r === reiter));
  const tag = spielTag();
  $('blatt-welt').textContent = tag ? ` · Tag ${tag}` : START ? '' : ' · ' + location.host;
  graphStopp();
  ({notizen: notizenZeigen, graph: graphZeigen, plan: planZeigen, spionage: spionageZeigen, ziele: zieleZeigen}[reiter])();
}

// ------------------------------------------------------------------ Koordinaten: kopieren, merken, Flotte
function kopieren(text) { try { app.kopieren(text); brumm(); toast(`„${text}“ kopiert`); } catch (e) { toast(e.message, true); } }
function merken(k, name = '') {
  const z = ziele();
  const da = z.liste.find(x => x.k === k);
  if (da) { da.zuletzt = jetzt(); if (name && !da.name) da.name = name; }
  else z.liste.unshift({id: uid(), k, name, notiz: '', zuletzt: jetzt()});
  speichern('koordinaten'); brumm(); toast(`${k} gemerkt`);
}
function zuletztBenutzt(k) { const z = ziele(); const d = z.liste.find(x => x.k === k); if (d) { d.zuletzt = jetzt(); speichern('koordinaten'); } }
/** Füllt das Flottenformular des Spiels (pickFleet) – senden muss der Spieler selbst. */
function flotte(k, mission) {
  if (!imSpiel()) { kopieren(k); toast('Koordinate kopiert – im Spiel bei „Ziel“ einfügen'); return; }
  try {
    window.pickFleet(k, mission || 'angriff');
    zuletztBenutzt(k);
    schliessen(); menueZu();
    toast(`Flotte nach ${k} vorbereitet (${(MISSIONEN.find(m => m[0] === mission) || [, mission])[1]}) – Schiffe wählen und senden`);
  } catch (e) { toast('Flottenformular nicht gefunden: ' + e.message, true); }
}
// Mond an der Koordinate (eigener, aus der Galaxie oder aus Mondberichten bekannt) – Karl 30.10.2026: „den Mond von einem
// Planeten über Koordinaten anfliegen“. Öffnet die Einsatzplanung mit Zielart Mond; dort stehen die passenden Aufträge.
function mondBei(k) {
  const v = spielView(); if (!v) return null;
  return (v.monde?.eigene || []).find(m => m.koord === k) || (v.atlas || []).find(a => a.koord === k && a.mond)?.mond || (v.monde?.bekannt || []).find(m => m.koord === k) || null;
}
function flotteMond(k) {
  if (!imSpiel() || !window.Einsatz?.oeffnen) { kopieren(k); toast('Koordinate kopiert – im Spiel bei „Ziel“ einfügen'); return; }
  window.Einsatz.oeffnen({ziel: k, zielart: 'mond'});
  zuletztBenutzt(k); schliessen(); menueZu();
}
function missionWahl(k, x, y) {
  // Auftragszeichen und -farben aus dem Spiel (web-client/auftraege.js), damit die Auswahl überall gleich aussieht.
  const zeichen = m => window.Auftraege ? window.Auftraege.badge(m, {size: 22}) + ' ' : '';
  const mond = mondBei(k);
  menue(x, y, `<b class="menue-kopf">Flotte nach ${esc(k)}</b>` + MISSIONEN.filter(([m]) => m !== 'verstaerken' || 'invasionen' in (spielView() || {})).map(([m, n]) => `<button data-m="${m}" class="menue-auftrag">${zeichen(m)}${n}</button>`).join('')
    + (mond ? `<button data-mond class="menue-auftrag">☾ Mond ${esc(mond.name || '')} anfliegen</button>` : ''), el => {
    el.querySelectorAll('[data-m]').forEach(b => b.onclick = () => flotte(k, b.dataset.m));
    const mb = el.querySelector('[data-mond]'); if (mb) mb.onclick = () => flotteMond(k);
  });
}

function menue(x, y, html, binden) {
  const m = $('menue');
  m.innerHTML = html; m.hidden = false;
  const b = Math.min(innerWidth - 16, 300);
  m.style.width = b + 'px';
  m.style.left = Math.max(8, Math.min(x - b / 2, innerWidth - b - 8)) + 'px';
  requestAnimationFrame(() => { const h = m.offsetHeight; m.style.top = Math.max(8, Math.min(y + 12, innerHeight - h - 8)) + 'px'; });
  binden?.(m);
}
function menueZu() { $('menue').hidden = true; }
document.addEventListener('pointerdown', e => { if (!$('menue').hidden && !e.composedPath().includes($('menue'))) menueZu(); }, true);

// Planetenname aus dem Spiel (planetenname.js): eigene und verbündete Planeten, sonst ''.
const planetName = k => { try { const P = window.Planetenname; const e = P?.eigen(k); return e ? P.name(e) : P?.zuKoord(k) || ''; } catch { return ''; } };

function koordMenue(k, x, y, kontext = '') {
  brumm();
  const pn = planetName(k), eigen = imSpiel() && !!window.Planetenname?.eigen(k);
  menue(x, y, `<b class="menue-kopf">📍 ${pn ? esc(pn) + ' ' : ''}${esc(k)}${kontext ? ' · ' + esc(kontext) : ''}</b>
    <button data-a="kopieren">Kopieren</button>
    <button data-a="merken">Bei Zielen merken</button>
    ${imSpiel() ? '<button data-a="flotte">Flotte hierhin …</button><button data-a="spionage">Ausspähen (Sonde)</button>' : ''}
    <button data-a="notiz">In Notiz übernehmen</button>
    ${eigen ? '<button data-a="umbenennen">Planet umbenennen …</button>' : ''}`, el => {
    el.querySelector('[data-a=kopieren]').onclick = () => { kopieren(k); menueZu(); };
    el.querySelector('[data-a=merken]').onclick = () => { merken(k, kontext); menueZu(); };
    el.querySelector('[data-a=notiz]').onclick = () => { menueZu(); notizMitKoord(k, kontext); };
    const f = el.querySelector('[data-a=flotte]'); if (f) f.onclick = () => missionWahl(k, x, y);
    const s = el.querySelector('[data-a=spionage]'); if (s) s.onclick = () => flotte(k, 'spionage');
    const u = el.querySelector('[data-a=umbenennen]'); if (u) u.onclick = () => { menueZu(); window.Planetenname.oeffnen(k); };
  });
}

// Langes Drücken auf eine sichtbare Koordinate im Spiel öffnet das Koordinatenmenü.
document.addEventListener('contextmenu', e => {
  if (e.composedPath().includes(wirt)) return;
  const t = e.target;
  if (t && (t.closest?.('input,textarea,[contenteditable=true]'))) return;
  const r = document.caretRangeFromPoint?.(e.clientX, e.clientY);
  let k = null;
  if (r && r.startContainer.nodeType === 3) {
    const text = r.startContainer.textContent, o = r.startOffset;
    for (const m of text.matchAll(KOORD)) if (!istZeit(m[0]) && o >= m.index - 1 && o <= m.index + m[0].length + 1) { k = m[0]; break; }
  }
  if (!k && t?.closest) {
    // Kleines Element (Knopf, Zelle, Überschrift) mit genau einer Koordinate.
    const el = t.closest('button,td,th,h3,h4,li,a,span,p,summary,strong') || t;
    if (el.offsetParent !== null) { const ks = koordinaten(el.innerText).filter((v, i, a) => a.indexOf(v) === i); if (ks.length === 1 && el.innerText.length < 160) k = ks[0]; }
  }
  if (!k) return;
  e.preventDefault();
  getSelection()?.removeAllRanges();
  koordMenue(k, e.clientX, e.clientY);
}, true);

// Zielhilfe: Beim Tippen ins Zielfeld der Flotte erscheinen Zwischenablage und gemerkte Ziele.
let zielFeld = null;
document.addEventListener('focusin', e => {
  const f = e.target;
  if (!(f instanceof HTMLInputElement) || f.name !== 'ziel' || !f.closest('#fleet')) return;
  zielFeld = f; zielleiste();
});
function zielleisteZu() { $('zielleiste').hidden = true; if ($('blatt').hidden) $('fab').hidden = START; }
document.addEventListener('focusout', e => { if (e.target === zielFeld) setTimeout(() => { if (document.activeElement !== zielFeld) zielleisteZu(); }, 250); });
function zielSetzen(k) {
  if (!zielFeld) return;
  zielFeld.value = k;
  zielFeld.dispatchEvent(new Event('input', {bubbles: true}));
  zielFeld.dispatchEvent(new Event('change', {bubbles: true}));
  zuletztBenutzt(k); brumm();
  zielleisteZu(); zielFeld.blur();
}
function zielleiste() {
  let ablageK = '';
  try { ablageK = koordinaten(app.einfuegen())[0] || ''; } catch {}
  const liste = [...ziele().liste].sort((a, b) => (b.zuletzt || 0) - (a.zuletzt || 0)).slice(0, 8);
  const leiste = $('zielleiste');
  leiste.innerHTML = (ablageK ? `<button class="chip gold" data-k="${esc(ablageK)}">📋 ${esc(ablageK)}</button>` : '') +
    liste.map(z => `<button class="chip" data-k="${esc(z.k)}">${esc(z.k)}${z.name ? ' · ' + esc(z.name) : ''}</button>`).join('') +
    (!ablageK && !liste.length ? '<span class="matt">Noch keine Ziele gemerkt – Koordinaten im Spiel lange drücken.</span>' : '');
  leiste.hidden = false; $('fab').hidden = true;
  leiste.querySelectorAll('[data-k]').forEach(b => b.onpointerdown = ev => { ev.preventDefault(); zielSetzen(b.dataset.k); });
}

// ------------------------------------------------------------------ Spionageordner: jeden Bericht automatisch ablegen
const summe = o => Object.values(o || {}).reduce((s, v) => s + (Number(v) || 0), 0);
function hash(s) { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return (h >>> 0).toString(36); }
let letzteBerichte = null;
function berichteErfassen() {
  const v = spielView(), w = spielWelt();
  if (!v || !Array.isArray(v.berichte) || v.berichte === letzteBerichte) return;
  letzteBerichte = v.berichte;
  const s = spionage(); let neu = 0;
  for (const b of v.berichte) {
    if (!b || typeof b.ziel !== 'string' || !koordinaten(b.ziel).length) continue;
    const daten = {bestand: b.bestand || null, schiffe: b.schiffe || null, verteidigung: b.verteidigung || null, gebaeude: b.gebaeude || null, forschung: b.forschung || null};
    const key = b.ziel + '|' + hash(JSON.stringify(daten));
    const vorhanden = s.berichte[key];
    if (vorhanden) { vorhanden.gesehen = jetzt(); continue; }
    s.berichte[key] = {ziel: b.ziel, besitzer: String(b.besitzer || ''), spielzeit: w ? (w.sekunden || 0) - (Number(b.alter_stunden) || 0) * 3600 : null,
      erfasst: jetzt(), gesehen: jetzt(), daten, aufklaerung: b.aufklaerung ?? null, ordner: [], notiz: '', stern: false};
    neu++;
  }
  // Höchstens 3000 Berichte: die ältesten ohne Stern, Ordner oder Notiz fallen weg.
  const keys = Object.keys(s.berichte);
  if (keys.length > 3000) keys.filter(k => !s.berichte[k].stern && !s.berichte[k].ordner.length && !s.berichte[k].notiz)
    .sort((a, b) => s.berichte[a].erfasst - s.berichte[b].erfasst).slice(0, keys.length - 3000).forEach(k => delete s.berichte[k]);
  if (neu) { speichern('spionage'); if (!$('blatt').hidden && reiter === 'spionage') zeichnen(); else toast(`${neu} neue${neu === 1 ? 'r' : ''} Spionagebericht${neu === 1 ? '' : 'e'} abgelegt`); }
}
if (!START) setInterval(berichteErfassen, 4000);

// Neue Spieler ohne Platz: einmal sanft zur Volkswahl führen (sie steht sonst weit unten).
let platzGezeigt = false, platzErledigt = false;
if (!START) setInterval(() => {
  if (platzErledigt) return;
  let s = null; try { s = typeof session !== 'undefined' ? session : null; } catch {}
  const f = document.getElementById('claim');
  if (!platzGezeigt && s && !s.spieler && f && f.offsetParent !== null) {
    platzGezeigt = true;
    (document.getElementById('claim-panel') || f).scrollIntoView({behavior: 'smooth', block: 'start'});
    toast('Wähle dein Volk und wie du spielst, dann „Jetzt mitspielen“ – dann gehört dir ein Heimatplanet.');
  } else if (s?.spieler) {
    // Gerade beigetreten: zurück nach oben zur Übersicht des neuen Reichs.
    if (platzGezeigt) scrollTo({top: 0, behavior: 'smooth'});
    platzErledigt = true;
  }
}, 1500);

// Meldungen des Spiels erscheinen unten rechts: solange tritt der ◆-Knopf zurück.
if (!START) {
  const meldung = document.getElementById('message');
  if (meldung) new MutationObserver(() => $('fab').classList.toggle('leise', !meldung.hidden)).observe(meldung, {attributes: true, attributeFilter: ['hidden']});
}

let spFilter = {ordner: '', suche: '', sort: 'neu'};
function spionageZeigen() {
  const s = spionage();
  const alle = Object.entries(s.berichte).map(([key, b]) => ({key, ...b}));
  // Je Ziel der neueste Bericht oben, ältere als Verlauf darunter.
  const jeZiel = {};
  for (const b of alle) (jeZiel[b.ziel] ||= []).push(b);
  for (const l of Object.values(jeZiel)) l.sort((a, b) => (b.spielzeit ?? b.erfasst) - (a.spielzeit ?? a.erfasst));
  let gruppen = Object.values(jeZiel);
  const q = spFilter.suche.toLowerCase();
  gruppen = gruppen.filter(g => {
    const n = g[0];
    if (spFilter.ordner === '★') { if (!g.some(b => b.stern)) return false; }
    else if (spFilter.ordner && !g.some(b => b.ordner.includes(spFilter.ordner))) return false;
    return !q || (n.ziel + ' ' + n.besitzer + ' ' + g.map(b => b.notiz).join(' ')).toLowerCase().includes(q);
  });
  const wert = b => summe(b.daten.bestand), wehr = b => summe(b.daten.schiffe) + summe(b.daten.verteidigung);
