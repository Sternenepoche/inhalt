// ------------------------------------------------------------------ Notizen (Markdown wie Obsidian)
let notizCache = null, offeneNotiz = null, vorschau = true, notizSuche = '';
function notizen(neu = false) {
  if (!notizCache || neu) { try { notizCache = sync('notizListe'); } catch (e) { toast(e.message, true); notizCache = []; } }
  return notizCache;
}
const dateiname = s => String(s).replace(/[\\/:*?"<>|#\[\]]+/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 80) || 'Ohne Titel';
const titel = pfad => pfad.replace(/\.md$/, '').split('/').pop();
function notizSpeichern(pfad, text, sofort = false) {
  const n = notizen().find(x => x.pfad === pfad);
  if (n) { n.text = text; n.geaendert = jetzt(); } else notizCache.push({pfad, text, geaendert: jetzt()});
  clearTimeout(notizSpeichern.t);
  const tun = () => { try { sync('notizSchreiben', pfad, text); } catch (e) { toast('Notiz nicht gespeichert: ' + e.message, true); } };
  if (sofort) tun(); else notizSpeichern.t = setTimeout(tun, 600);
}
const links = text => [...String(text).matchAll(/\[\[([^\]|#]+)(?:#[^\]|]*)?(?:\|[^\]]*)?\]\]/g)].map(m => m[1].trim());
const tags = text => [...String(text).matchAll(/(?:^|\s)#([\p{L}\p{N}_/-]{2,40})/gu)].map(m => m[1]);
const findeNotiz = name => { const n = name.toLowerCase(); return notizen().find(x => titel(x.pfad).toLowerCase() === n || x.pfad.toLowerCase() === n + '.md' || x.pfad.toLowerCase() === n); };

/** Koordinaten im Text werden zu Knöpfen (Flotte, kopieren); Verweise zu Links. */
function verlinken(t) {
  return esc(t).replace(KOORD, (m) => istZeit(m) ? m : `<button class="koord klein" data-koord="${m}">${m}</button>`);
}
function koordKnoepfe(el) {
  el.querySelectorAll('[data-koord]').forEach(b => b.onclick = ev => { ev.stopPropagation(); koordMenue(b.dataset.koord, ev.clientX, ev.clientY); });
}
function markdown(md) {
  const zeilen = String(md).replace(/\r/g, '').split('\n');
  let html = '', inListe = false, inCode = false, tabelle = [];
  const inline = s => verlinken(s)
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>').replace(/(^|[^*])\*([^*]+)\*/g, '$1<i>$2</i>')
    .replace(/\[\[([^\]|]+?)(?:\|([^\]]+))?\]\]/g, (m, z, a) => `<a class="wiki ${findeNotiz(z.split('#')[0].trim()) ? '' : 'neu'}" data-wiki="${z.split('#')[0].trim()}">${a || z}</a>`)
    .replace(/(^|\s)#([\p{L}\p{N}_/-]{2,40})/gu, '$1<a class="tag" data-tag="$2">#$2</a>')
    .replace(/\bhttps?:\/\/[^\s<]+/g, u => `<a href="${u}" target="_blank" rel="noopener">${u}</a>`);
  const tabelleAus = () => {
    if (!tabelle.length) return;
    const zellen = r => r.replace(/^\||\|$/g, '').split('|').map(c => c.trim());
    const kopf = zellen(tabelle[0]), rest = tabelle.slice(tabelle[1] && /^[\s|:-]+$/.test(tabelle[1]) ? 2 : 1);
    html += `<table><thead><tr>${kopf.map(c => `<th>${inline(c)}</th>`).join('')}</tr></thead><tbody>${rest.map(r => `<tr>${zellen(r).map(c => `<td>${inline(c)}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
    tabelle = [];
  };
  zeilen.forEach((z, i) => {
    if (z.startsWith('```')) { tabelleAus(); if (inListe) { html += '</ul>'; inListe = false; } html += inCode ? '</pre>' : '<pre>'; inCode = !inCode; return; }
    if (inCode) { html += esc(z) + '\n'; return; }
    if (/^\s*\|.*\|\s*$/.test(z)) { if (inListe) { html += '</ul>'; inListe = false; } tabelle.push(z.trim()); return; }
    tabelleAus();
    const li = z.match(/^\s*[-*]\s+(\[( |x|X)\]\s+)?(.*)$/);
    if (li) {
      if (!inListe) { html += '<ul>'; inListe = true; }
      html += li[1] ? `<li class="aufgabe"><button class="haken klein" data-zeile="${i}">${li[2] !== ' ' ? '✓' : ''}</button><span class="${li[2] !== ' ' ? 'erledigt' : ''}">${inline(li[3])}</span></li>` : `<li>${inline(li[3])}</li>`;
      return;
    }
    if (inListe) { html += '</ul>'; inListe = false; }
    const h = z.match(/^(#{1,4})\s+(.*)$/);
    if (h) html += `<h${h[1].length + 1}>${inline(h[2])}</h${h[1].length + 1}>`;
    else if (z.startsWith('> ')) html += `<blockquote>${inline(z.slice(2))}</blockquote>`;
    else if (/^---+$/.test(z.trim())) html += '<hr>';
    else if (z.trim()) html += `<p>${inline(z)}</p>`;
  });
  tabelleAus();
  if (inListe) html += '</ul>';
  if (inCode) html += '</pre>';
  return html;
}

function notizenZeigen() {
  if (offeneNotiz) return notizBearbeiten(offeneNotiz);
