// ------------------------------------------------------------------ Wissensgraph
let graphLauf = null;
function graphStopp() { if (graphLauf) { cancelAnimationFrame(graphLauf.raf); graphLauf = null; } }
function graphZeigen() {
  const alle = notizen(true);
  $('inhalt').innerHTML = `<div class="graph-kopf"><span class="matt">${alle.length} Notizen · tippen öffnet, ziehen verschiebt, zwei Finger zoomen</span>
    <label class="matt"><input type="checkbox" id="g-tags"> #Schlagworte</label></div><canvas id="graph"></canvas>`;
  const cv = $('graph'), ctx = cv.getContext('2d');
  const dpr = devicePixelRatio || 1;
  const groesse = () => { const r = cv.getBoundingClientRect(); cv.width = r.width * dpr; cv.height = r.height * dpr; };
  groesse();
  const mitTags = () => $('g-tags').checked;
  let knoten = [], kanten = [];
  const aufbauen = () => {
    const idx = {};
    knoten = []; kanten = [];
    const add = (id, name, art) => { if (idx[id] == null) { idx[id] = knoten.length; knoten.push({id, name, art, x: (Math.random() - .5) * 400, y: (Math.random() - .5) * 400, vx: 0, vy: 0, grad: 0}); } return idx[id]; };
    alle.forEach(n => add(n.pfad.toLowerCase(), titel(n.pfad), 'notiz'));
    alle.forEach(n => {
      const a = idx[n.pfad.toLowerCase()];
      links(n.text).forEach(l => { const z = findeNotiz(l); const b = z ? idx[z.pfad.toLowerCase()] : add('?' + l.toLowerCase(), l, 'fehlt'); if (a !== b) kanten.push([a, b]); });
      if (mitTags()) tags(n.text).forEach(t => kanten.push([a, add('#' + t.toLowerCase(), '#' + t, 'tag')]));
    });
    kanten.forEach(([a, b]) => { knoten[a].grad++; knoten[b].grad++; });
  };
  aufbauen();
  $('g-tags').onchange = () => { aufbauen(); waerme = 1; einpassen = true; };
  let cam = {x: 0, y: 0, z: 1}, waerme = 1, einpassen = true;
  const welt = (px, py) => ({x: (px * dpr - cv.width / 2) / cam.z / dpr - cam.x, y: (py * dpr - cv.height / 2) / cam.z / dpr - cam.y});
  const schritt = () => {
    if (waerme > .02) {
      for (let i = 0; i < knoten.length; i++) for (let j = i + 1; j < knoten.length; j++) {
        const a = knoten[i], b = knoten[j]; let dx = a.x - b.x, dy = a.y - b.y; const d2 = dx * dx + dy * dy + .01;
        if (d2 > 90000) continue; const f = 900 / d2; a.vx += dx * f; a.vy += dy * f; b.vx -= dx * f; b.vy -= dy * f;
      }
      kanten.forEach(([i, j]) => { const a = knoten[i], b = knoten[j]; const dx = b.x - a.x, dy = b.y - a.y; const d = Math.hypot(dx, dy) || 1; const f = (d - 70) * .02; a.vx += dx / d * f; a.vy += dy / d * f; b.vx -= dx / d * f; b.vy -= dy / d * f; });
      knoten.forEach(k => { if (k.fest) return; k.vx -= k.x * .004; k.vy -= k.y * .004; k.x += k.vx * waerme; k.y += k.vy * waerme; k.vx *= .55; k.vy *= .55; });
      waerme *= .985;
    }
    // Solange niemand die Ansicht bewegt: alles ins Bild einpassen.
    if (einpassen && knoten.length) {
      const xs = knoten.map(k => k.x), ys = knoten.map(k => k.y);
      const b = Math.max(80, Math.max(...xs) - Math.min(...xs)), h = Math.max(80, Math.max(...ys) - Math.min(...ys));
      const w = cv.width / dpr, hh = cv.height / dpr;
      cam.z = Math.max(.25, Math.min(1.6, .78 * Math.min(w / b, hh / h)));
      cam.x = -(Math.max(...xs) + Math.min(...xs)) / 2; cam.y = -(Math.max(...ys) + Math.min(...ys)) / 2;
    }
    ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.clearRect(0, 0, cv.width, cv.height);
    ctx.setTransform(cam.z * dpr, 0, 0, cam.z * dpr, cv.width / 2 + cam.x * cam.z * dpr, cv.height / 2 + cam.y * cam.z * dpr);
    ctx.strokeStyle = 'rgba(127,211,255,.28)'; ctx.lineWidth = 1 / cam.z;
    ctx.beginPath(); kanten.forEach(([i, j]) => { ctx.moveTo(knoten[i].x, knoten[i].y); ctx.lineTo(knoten[j].x, knoten[j].y); }); ctx.stroke();
    knoten.forEach(k => {
      const r = 4 + Math.min(10, Math.sqrt(k.grad) * 2.4);
      ctx.beginPath(); ctx.arc(k.x, k.y, r, 0, Math.PI * 2);
      ctx.fillStyle = k.art === 'tag' ? '#8fdca5' : k.art === 'fehlt' ? 'rgba(142,163,184,.45)' : k === graphLauf?.aktiv ? '#f3d9a6' : '#7fd3ff';
      ctx.fill();
      if (cam.z > .55 || k.grad > 2) { ctx.fillStyle = k.art === 'fehlt' ? '#8ea3b8' : '#e4ecf4'; ctx.font = `${12 / Math.max(.8, cam.z)}px system-ui`; ctx.textAlign = 'center'; ctx.fillText(k.name.slice(0, 28), k.x, k.y + r + 13 / Math.max(.8, cam.z)); }
